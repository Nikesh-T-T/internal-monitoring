<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout">

	<Dialog
		id="credentialDialog"
		title="{i18n>credentialDialogTitle}"
		contentWidth="42rem"
		resizable="true"
		busy="{dialog>/busy}">

		<content>
			<l:VerticalLayout width="100%" class="sapUiSmallMargin">

				<MessageStrip
					text="{i18n>credentialMissingText}"
					type="Information"
					showIcon="true"
					class="sapUiSmallMarginBottom"
					visible="{= ${dialog>/reason} === 'missing' }" />

				<MessageStrip
					text="{i18n>credentialExpiredText}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginBottom"
					visible="{= ${dialog>/reason} === 'expired' }" />

				<Text text="{i18n>credentialInstructions}" class="sapUiSmallMarginBottom" />

				<Label text="{i18n>credentialCookieLabel}" labelFor="cookieInput" required="true" />
				<TextArea
					id="cookieInput"
					value="{dialog>/cookie}"
					width="100%"
					rows="8"
					wrapping="Soft"
					placeholder="{i18n>credentialCookiePlaceholder}" />

				<MessageStrip
					text="{dialog>/message}"
					type="Error"
					showIcon="true"
					class="sapUiSmallMarginTop"
					visible="{= !!${dialog>/message} }" />

				<Text text="{i18n>credentialPrivacyNote}" class="sapUiSmallMarginTop" />

			</l:VerticalLayout>
		</content>

		<beginButton>
			<Button
				text="{i18n>credentialSaveButton}"
				type="Emphasized"
				press="onSave" />
		</beginButton>

		<endButton>
			<Button
				text="{i18n>credentialCancelButton}"
				press="onCancel" />
		</endButton>

	</Dialog>

</core:FragmentDefinition>
