{
  "_version": "1.59.0",
  "sap.app": {
    "id": "monitoring",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/MonitoringService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.fe.core.rootView.Fcl",
      "type": "XML",
      "id": "appRootView",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.layout": {},
        "sap.ui.codeeditor": {},
        "sap.f": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "monitoring.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
        }
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MessagesList",
          "target": "MessagesList",
          "layout": "OneColumn"
        },
        {
          "pattern": "Messages({key}):?query:",
          "name": "MessagesDetail",
          "target": ["MessagesList", "MessagesDetail"],
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "pattern": "ServiceOverview:?query:",
          "name": "ServiceOverviewList",
          "target": "ServiceOverviewList",
          "layout": "OneColumn"
        }
      ],
      "targets": {
        "MessagesList": {
          "type": "Component",
          "id": "MessagesList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "options": {
            "settings": {
              "contextPath": "/Messages",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Messages": {
                  "detail": {
                    "route": "MessagesDetail"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "setCredentials": {
                      "id": "setCredentialsAction",
                      "text": "{i18n>credentialActionText}",
                      "press": "monitoring.ext.CredentialActions.openCredentialDialog",
                      "enabled": true,
                      "position": {
                        "placement": "Before"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "MessagesDetail": {
          "type": "Component",
          "id": "MessagesDetail",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "options": {
            "settings": {
              "contextPath": "/Messages",
              "editableHeaderContent": false,
              "content": {
                "body": {
                  "sections": {
                    "payloadSection": {
                      "template": "monitoring.view.PayloadSection",
                      "title": "{i18n>payloadSectionTitle}"
                    },
                    "headersSection": {
                      "template": "monitoring.view.HeadersSection",
                      "title": "{i18n>headersSectionTitle}",
                      "position": {
                        "placement": "After",
                        "anchor": "payloadSection"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ServiceOverviewList": {
          "type": "Component",
          "id": "ServiceOverviewList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "options": {
            "settings": {
              "contextPath": "/ServiceOverview",
              "variantManagement": "Page",
              "initialLoad": true
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  }
}
